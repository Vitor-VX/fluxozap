# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Timezone used by default funnel variables such as {{data}} and {{hora}}
APP_TIME_ZONE="America/Cuiaba"

# Meta WhatsApp Cloud API credentials (Optional via env or via UI in Settings tab)
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_WABA_ID=""
WHATSAPP_VERIFY_TOKEN="fluxozap_webhook_secret_2026"

# XPag Global (SPEI / OXXO no México)
XPAG_CLIENT_ID=""
XPAG_CLIENT_SECRET=""
XPAG_ENABLED="false"
XPAG_ENVIRONMENT="sandbox"
# URL pública do FluxoZap, sem barra final (ex: https://app.seudominio.com)
PUBLIC_BASE_URL=""

# MongoDB Atlas Cloud Database URI (https://account.mongodb.com/)
# The server always selects the dedicated database named FluxoZap.
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=""

# Cloudflare R2 Object Storage (https://dash.cloudflare.com/)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""
